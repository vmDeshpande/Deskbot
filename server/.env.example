DESKBOT_SERVICE_NAME=Deskbot API
DESKBOT_VERSION=1.0.0
DESKBOT_ENVIRONMENT=development
DESKBOT_HOST=0.0.0.0
DESKBOT_PORT=8000
DESKBOT_WEBSOCKET_PATH=/ws/device
# JSON mapping of provisioned device UUID to SHA-256 digest of its 64-hex-character token.
# Keep real verifiers and tokens in an ignored local .env file or protected environment file.
DESKBOT_DEVICE_TOKEN_HASHES={}
DESKBOT_DEFAULT_LANGUAGE=hi-IN
DESKBOT_TIMEZONE=Asia/Kolkata
DESKBOT_DEFAULT_LOCATION=Nashik, Maharashtra, India
DESKBOT_STT_PROVIDER=whisper
DESKBOT_WHISPER_MODEL=small
DESKBOT_WHISPER_DEVICE=cpu
DESKBOT_WHISPER_COMPUTE_TYPE=int8
DESKBOT_LANGUAGE_MODE=auto
DESKBOT_SUPPORTED_LANGUAGES=en,hi,mr
DESKBOT_AUDIO_MIN_DURATION_S=0.5
DESKBOT_WHISPER_NO_SPEECH_THRESHOLD=0.6
DESKBOT_WHISPER_LOG_PROB_THRESHOLD=-1.0
DESKBOT_WHISPER_COMPRESSION_RATIO_THRESHOLD=2.4
DESKBOT_WHISPER_VAD_FILTER=true
DESKBOT_WHISPER_VAD_PARAMETERS={"min_silence_duration_ms": 500}

# Groq Intelligence Provider
DESKBOT_INTELLIGENCE_PROVIDER=groq
DESKBOT_INTELLIGENCE_ENABLED=true
DESKBOT_GROQ_API_KEY=
DESKBOT_GROQ_MODEL=llama-3.3-70b-versatile

# Google Cloud TTS Provider
DESKBOT_TTS_ENABLED=false
DESKBOT_TTS_PROVIDER=google
DESKBOT_TTS_LANGUAGE=en-IN
DESKBOT_TTS_VOICE_EN=en-IN-Standard-B
DESKBOT_TTS_VOICE_HI=hi-IN-Standard-A
DESKBOT_TTS_VOICE_MR=mr-IN-Standard-A
DESKBOT_TTS_SAMPLE_RATE=16000
DESKBOT_TTS_AUDIO_FORMAT=pcm_s16le